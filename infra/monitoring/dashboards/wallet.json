          "decimals": 2,
          "noValue": "0.00"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Spend by category in ${month:text}",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
