{
  "uid": "wallet",
  "title": "Wallet",
  "tags": [
    "pet-project"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "description": "Monthly spending by category for the month chosen in the Month variable (last 12 months in Europe/Warsaw, default: the current month). The only query is backend/src/main/resources/db/report/by-category.sql (the SQL of GET /api/reports/by-category) with :month replaced by the month variable; the other panels reuse its result. Shows all data (single user), read from prod Postgres as the read-only role grafana_reader.",
  "time": {
    "from": "now/M",
    "to": "now/M"
  },
  "timepicker": {
    "hidden": true
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "month",
        "label": "Month",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wallet-postgres"
        },
        "query": "select to_char(m, 'YYYY-MM') as __text, to_char(m, 'YYYY-MM-DD') as __value\nfrom generate_series(date_trunc('month', now() at time zone 'Europe/Warsaw') - interval '11 months',\n                     date_trunc('month', now() at time zone 'Europe/Warsaw'),\n                     interval '1 month') as g(m)\norder by m desc",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "allowCustomValue": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "Total spent in ${month:text}",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
